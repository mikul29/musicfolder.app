// Cloudflare Workers static-assets config: serves this folder as the site.
{
  "name": "musicfolder-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    // keep the .html addresses exactly as linked (support.html, privacy.html…)
    "html_handling": "none",
    "not_found_handling": "none"
  }
}

// Cloudflare Workers static-assets config: serves this folder as the site.
// Default html handling: /support.html is served at /support (old links redirect).
// Missing addresses get 404.html with a real 404 status.
// worker/index.js runs only for /get (App Store buttons) and /hit (visits starting), see README.
{
  "name": "musicfolder-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/get", "/hit"]
  },
  // App Store button taps, one data point each (kept 3 months by Cloudflare; the
  // intelligence platform archives them daily). Analytics Engine must be enabled on the account.
  "analytics_engine_datasets": [
    { "binding": "TAPS", "dataset": "musicfolder_app_store_taps" },
    // Visits starting (the page and where they came from), counted by site.js through /hit.
    { "binding": "LANDINGS", "dataset": "musicfolder_landings" }
  ],
  "vars": {
    // App Store Connect → Apps → Music Folder → Analytics → Acquisition → Campaigns → "Generate
    // Campaign Link": the number after pt=. Not a secret (it's in every public campaign link).
    // Empty = buttons go to the plain App Store link (taps are still counted). Set 2026-10-29.
    "APP_STORE_PROVIDER_TOKEN": "124086599"
  }
}
